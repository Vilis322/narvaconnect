# NarvaConnect — nginx config example
# Copy to /etc/nginx/sites-available/narvaconnect.app
# VPS: 64.111.93.12 (Ubuntu 22.04)
# SSL: certbot --nginx -d narvaconnect.app

server {
    listen 80;
    server_name narvaconnect.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name narvaconnect.app;

    # SSL (Let's Encrypt — uncomment after certbot)
    # ssl_certificate /etc/letsencrypt/live/narvaconnect.app/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/narvaconnect.app/privkey.pem;

    # Frontend (React static build)
    location / {
        root /var/www/narvaconnect/frontend/dist;
        try_files $uri $uri/ /index.html;
    }

    # Backend API (FastAPI, PM2-managed)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;           # SSE streaming for /api/chat
        proxy_read_timeout 120s;
    }

    # WebSocket for live server logs
    location /ws/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
