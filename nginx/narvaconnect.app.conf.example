# NarvaConnect — nginx config example
# Copy to /etc/nginx/sites-available/narvaconnect.app
# Replace {SERVER_IP} with actual VPS IP
# SSL: certbot --nginx -d narvaconnect.app

server {
    listen 80;
    server_name narvaconnect.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name narvaconnect.app;

    # SSL (Let's Encrypt — uncomment after certbot)
    # ssl_certificate /etc/letsencrypt/live/narvaconnect.app/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/narvaconnect.app/privkey.pem;

    # Frontend (React build)
    location / {
        root /var/www/narvaconnect/frontend/dist;
        try_files $uri $uri/ /index.html;
    }

    # Backend API (NestJS, PM2 cluster)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
    }

    # AI chat (proxied to MLX/FastAPI on same machine or ai-opsctl)
    # Uncomment when AI is deployed
    # location /ai/ {
    #     proxy_pass http://127.0.0.1:8100/ml/;
    #     proxy_buffering off;          # SSE streaming
    #     proxy_read_timeout 300s;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    # }
}
